<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Admin - Portal As-Sa'adah</title>
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#65B32E">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .bg-saadah-green { background-color: #65B32E; }
        .bg-saadah-teal { background-color: #007A87; }
        .bg-saadah-orange { background-color: #F39200; }
        .text-saadah-teal { color: #007A87; }
        .text-saadah-green { color: #65B32E; }
    </style>
</head>
<body class="bg-white text-slate-800 min-h-screen flex flex-col md:flex-row">

    <!-- NAVIGASI MOBILE (HEADER HP & TAB) -->
    <div class="md:hidden bg-white border-b border-slate-200 p-4 flex items-center justify-between sticky top-0 z-20">
        <div class="flex items-center gap-2">
            <img src="/logo.png" onerror="this.onerror=null; this.src='/favicon.svg';" alt="Logo" class="w-8 h-8 object-contain">
            <span class="font-extrabold text-sm text-slate-900">Admin Portal</span>
        </div>
        <div class="flex items-center gap-2">
            <a href="/api/export-excel" class="bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1.5 rounded-lg border border-emerald-300">📊 Excel</a>
            <a href="/logout" class="text-xs text-red-600 font-bold px-2 py-1">Logout</a>
        </div>
    </div>

    <!-- SIDEBAR PC & TABLET DESKTOP -->
    <aside class="w-64 bg-white border-r border-slate-200 hidden md:flex flex-col justify-between p-5 min-h-screen sticky top-0">
        <div>
            <div class="flex items-center gap-3 pb-6 border-b border-slate-100 mb-6">
                <img src="/logo.png" onerror="this.onerror=null; this.src='/favicon.svg';" alt="Logo" class="w-10 h-10 object-contain">
                <div>
                    <h2 class="font-extrabold text-sm text-slate-900 leading-tight">As-Sa'adah</h2>
                    <p class="text-[10px] text-slate-400 font-medium uppercase">Admin Management</p>
                </div>
            </div>

            <nav class="space-y-1.5">
                <a href="/admin/dashboard" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold bg-lime-50 text-saadah-green border border-lime-200">
                    <span>⚙️</span> Kelola Master Data
                </a>
                <a href="/api/export-excel" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-500 hover:bg-slate-50 transition">
                    <span>📊</span> Rekap Excel Semua Data
                </a>
            </nav>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-lime-100 text-saadah-green font-bold flex items-center justify-center text-xs">
                    <%= admin ? admin.name.charAt(0) : 'A' %>
                </div>
                <div class="overflow-hidden">
                    <p class="text-xs font-bold text-slate-800 truncate"><%= admin ? admin.name : 'Administrator' %></p>
                    <p class="text-[10px] text-slate-400">Admin Lembaga</p>
                </div>
            </div>
            <a href="/logout" class="text-xs text-red-500 hover:text-red-700 font-bold" title="Logout">🚪</a>
        </div>
    </aside>

    <!-- KONTEN UTAMA -->
    <div class="flex-1 flex flex-col min-w-0">

        <header class="hidden md:flex bg-white border-b border-slate-200 px-6 py-4 items-center justify-between sticky top-0 z-10">
            <div>
                <h1 class="text-lg font-bold text-slate-900">Manajemen Data Master Portal</h1>
                <p class="text-xs text-slate-500">Kelola akun Ustadz, Wali, Santri, dan Penugasan Program.</p>
            </div>
            <a href="/api/export-excel" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-bold px-4 py-2 rounded-xl border border-emerald-300 transition flex items-center gap-2">
                <span>📊</span> Unduh Semua Data (.xlsx)
            </a>
        </header>

        <main class="p-4 md:p-6 space-y-6 max-w-7xl">

            <!-- METRIK RINGKASAN -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                    <span class="text-[10px] md:text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Santri</span>
                    <h3 class="text-xl md:text-2xl font-extrabold text-slate-900 mt-1"><%= santriList ? santriList.length : 0 %></h3>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                    <span class="text-[10px] md:text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Ustadz</span>
                    <h3 class="text-xl md:text-2xl font-extrabold text-saadah-teal mt-1"><%= ustadzList ? ustadzList.length : 0 %></h3>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                    <span class="text-[10px] md:text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Wali</span>
                    <h3 class="text-xl md:text-2xl font-extrabold text-saadah-green mt-1"><%= waliList ? waliList.length : 0 %></h3>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                    <span class="text-[10px] md:text-[11px] font-bold text-slate-400 uppercase tracking-wider">Penugasan</span>
                    <h3 class="text-xl md:text-2xl font-extrabold text-saadah-orange mt-1"><%= assignments ? assignments.length : 0 %></h3>
                </div>
            </div>

            <!-- FORM INPUT DATA MASTER -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                
                <!-- Tambah Ustadz -->
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                    <h3 class="text-sm font-bold text-slate-900 mb-3 flex items-center gap-2">
                        <span class="p-1.5 bg-teal-50 text-saadah-teal rounded-lg">👨‍🏫</span> Tambah Ustadz / Dzah
                    </h3>
                    <form action="/api/add-ustadz" method="POST" class="space-y-3 text-xs">
                        <div>
                            <label class="block font-semibold text-slate-600 mb-1">Nama Lengkap</label>
                            <input type="text" name="name" required placeholder="Ustadz Abdullah" class="w-full p-2.5 border rounded-xl bg-slate-50 focus:bg-white focus:ring-saadah-green">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-600 mb-1">No. WhatsApp</label>
                            <input type="text" name="no_wa" required placeholder="081234567890" class="w-full p-2.5 border rounded-xl bg-slate-50 focus:bg-white focus:ring-saadah-green">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-600 mb-1">Password</label>
                            <input type="password" name="password" required placeholder="******" class="w-full p-2.5 border rounded-xl bg-slate-50 focus:bg-white focus:ring-saadah-green">
                        </div>
                        <button type="submit" class="w-full bg-saadah-teal hover:bg-teal-800 text-white font-bold py-2.5 rounded-xl transition">Simpan Ustadz</button>
                    </form>
                </div>

                <!-- Penugasan Program Ustadz -->
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                    <h3 class="text-sm font-bold text-slate-900 mb-3 flex items-center gap-2">
                        <span class="p-1.5 bg-amber-50 text-saadah-orange rounded-lg">📌</span> Penugasan Program
                    </h3>
                    <form action="/api/assign-ustadz" method="POST" class="space-y-3 text-xs">
                        <div>
                            <label class="block font-semibold text-slate-600 mb-1">Pilih Ustadz / Dzah</label>
                            <select name="ustadz_id" required class="w-full p-2.5 border rounded-xl bg-slate-50 focus:bg-white">
                                <% ustadzList.forEach(u => { %>
                                    <option value="<%= u.id %>"><%= u.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-600 mb-1">Program Mengajar</label>
                            <select name="program" required class="w-full p-2.5 border rounded-xl bg-slate-50 focus:bg-white">
                                <option value="Tahfidz">Tahfidz Al-Qur'an</option>
                                <option value="Aisar">Metode Aisar</option>
                                <option value="Bahasa Arab">Bahasa Arab</option>
                            </select>
                        </div>
                        <button type="submit" class="w-full bg-saadah-orange hover:bg-amber-600 text-white font-bold py-2.5 rounded-xl transition">Tetapkan Tugas</button>
                    </form>
                </div>

                <!-- Tambah Wali Santri -->
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                    <h3 class="text-sm font-bold text-slate-900 mb-3 flex items-center gap-2">
                        <span class="p-1.5 bg-lime-50 text-saadah-green rounded-lg">👨‍👩‍👧</span> Tambah Wali Santri
                    </h3>
                    <form action="/api/add-wali" method="POST" class="space-y-3 text-xs">
                        <div>
                            <label class="block font-semibold text-slate-600 mb-1">Nama Orang Tua / Wali</label>
                            <input type="text" name="name" required placeholder="Bapak Ahmad" class="w-full p-2.5 border rounded-xl bg-slate-50 focus:bg-white">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-600 mb-1">No. WhatsApp</label>
                            <input type="text" name="no_wa" required placeholder="081298765432" class="w-full p-2.5 border rounded-xl bg-slate-50 focus:bg-white">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-600 mb-1">Password</label>
                            <input type="password" name="password" required placeholder="******" class="w-full p-2.5 border rounded-xl bg-slate-50 focus:bg-white">
                        </div>
                        <button type="submit" class="w-full bg-saadah-green hover:bg-lime-700 text-white font-bold py-2.5 rounded-xl transition">Simpan Wali</button>
                    </form>
                </div>

            </div>

<!-- 1. FORM REGISTRASI SANTRI BARU (DENGAN PILIHAN BAHASA ARAB) -->
<div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
    <h3 class="text-sm font-bold text-slate-900 mb-3 flex items-center gap-2">
        <span class="p-1.5 bg-emerald-50 text-emerald-700 rounded-lg">👶</span> Registrasi Santri Baru
    </h3>
    <form action="/api/add-santri" method="POST" class="grid grid-cols-1 md:grid-cols-5 gap-3 text-xs">
        <div class="md:col-span-1">
            <label class="block font-semibold text-slate-600 mb-1">Nama Santri</label>
            <input type="text" name="nama_santri" required placeholder="Muhammad Ali" class="w-full p-2.5 border rounded-xl bg-slate-50">
        </div>
        <div class="md:col-span-1">
            <label class="block font-semibold text-slate-600 mb-1">Wali Santri</label>
            <select name="wali_id" required class="w-full p-2.5 border rounded-xl bg-slate-50">
                <% waliList.forEach(w => { %>
                    <option value="<%= w.id %>"><%= w.name %></option>
                <% }); %>
            </select>
        </div>
        <div class="md:col-span-1">
            <label class="block font-semibold text-slate-600 mb-1">Ustadz Pembimbing</label>
            <select name="ustadz_id" class="w-full p-2.5 border rounded-xl bg-slate-50">
                <option value="">-- Pilih Ustadz --</option>
                <% ustadzList.forEach(u => { %>
                    <option value="<%= u.id %>"><%= u.name %></option>
                <% }); %>
            </select>
        </div>
        
        <!-- DROPDOWN PROGRAM UTAMA (SUDAH DITAMBAHKAN BAHASA ARAB) -->
        <div class="md:col-span-1">
            <label class="block font-semibold text-slate-600 mb-1">Program Utama</label>
            <select name="program_utama" id="progUtama" onchange="toggleAisarLevelAdmin()" class="w-full p-2.5 border rounded-xl bg-slate-50">
                <option value="alquran">Al-Qur'an / Tahfidz</option>
                <option value="aisar">Metode Aisar</option>
                <option value="bahasa_arab">Bahasa Arab</option>
            </select>
        </div>
        
        <div class="md:col-span-1">
            <label class="block font-semibold text-slate-600 mb-1">Level Aisar (Khusus Aisar)</label>
            <select name="aisar_level" id="aisarLevel" class="w-full p-2.5 border rounded-xl bg-slate-50">
                <option value="">- Non-Aisar -</option>
                <option value="1">Level 1</option>
                <option value="2">Level 2</option>
                <option value="3">Level 3</option>
                <option value="4">Level 4</option>
            </select>
        </div>
        <div class="md:col-span-5 text-right">
            <button type="submit" class="bg-saadah-green hover:bg-lime-700 text-white font-bold px-6 py-2.5 rounded-xl transition">Daftarkan Santri</button>
        </div>
    </form>
</div>

<!-- 2. FORM TAMBAH USTADZ (SISTEM USERNAME) -->
<div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
    <h3 class="text-sm font-bold text-slate-900 mb-3 flex items-center gap-2">
        <span class="p-1.5 bg-teal-50 text-saadah-teal rounded-lg">👨‍🏫</span> Tambah Ustadz / Dzah
    </h3>
    <form action="/api/add-ustadz" method="POST" class="space-y-3 text-xs">
        <div>
            <label class="block font-semibold text-slate-600 mb-1">Nama Lengkap</label>
            <input type="text" name="name" required placeholder="Ustadz Abdullah" class="w-full p-2.5 border rounded-xl bg-slate-50">
        </div>
        <div>
            <label class="block font-semibold text-slate-600 mb-1">Username Login</label>
            <input type="text" name="username" placeholder="ustadz_abdullah" class="w-full p-2.5 border rounded-xl bg-slate-50">
        </div>
        <div>
            <label class="block font-semibold text-slate-600 mb-1">No. WhatsApp</label>
            <input type="text" name="no_wa" required placeholder="081234567890" class="w-full p-2.5 border rounded-xl bg-slate-50">
        </div>
        <div>
            <label class="block font-semibold text-slate-600 mb-1">Password</label>
            <input type="password" name="password" required placeholder="******" class="w-full p-2.5 border rounded-xl bg-slate-50">
        </div>
        <button type="submit" class="w-full bg-saadah-teal hover:bg-teal-800 text-white font-bold py-2.5 rounded-xl transition">Simpan Ustadz</button>
    </form>
</div>
            <!-- TABEL DATA SANTRI MASTER -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden p-5">
                <h3 class="text-sm font-bold text-slate-900 mb-4">Daftar Santri Terdaftar</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left text-slate-600 border-collapse">
                        <thead>
                            <tr class="bg-slate-50 text-slate-500 font-bold uppercase border-b border-slate-200">
                                <th class="p-3">Nama Santri</th>
                                <th class="p-3">Wali Santri</th>
                                <th class="p-3">Pembimbing</th>
                                <th class="p-3">Program</th>
                                <th class="p-3 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% if (santriList && santriList.length > 0) { %>
                                <% santriList.forEach(s => { %>
                                    <tr class="hover:bg-slate-50 transition">
                                        <td class="p-3 font-bold text-slate-900"><%= s.nama_santri %></td>
                                        <td class="p-3"><%= s.wali_name %></td>
                                        <td class="p-3"><%= s.ustadz_name %></td>
                                        <td class="p-3">
                                            <span class="bg-lime-100 text-saadah-green font-bold px-2 py-0.5 rounded-full">
                                                <%= s.program_utama ? s.program_utama.toUpperCase() : 'AL-QURAN' %> <%= s.aisar_level ? '(Lvl ' + s.aisar_level + ')' : '' %>
                                            </span>
                                        </td>
                                        <td class="p-3 text-center">
                                            <a href="/api/delete-santri/<%= s.id %>" onclick="return confirm('Hapus data santri ini?')" class="text-red-500 hover:text-red-700 font-bold">Hapus</a>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="p-6 text-center text-slate-400">Belum ada data santri.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

</body>
</html>