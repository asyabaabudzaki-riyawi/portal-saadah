<!DOCTYPE html>
<html lang="id">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=10">
    <link rel="alternate icon" type="image/png" href="/logo.png">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen">

    <!-- Header -->
    <header class="bg-emerald-900 text-white py-4 px-6 shadow-md">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div>
                <h1 class="text-xl font-bold">Portal Admin</h1>
                <p class="text-xs text-emerald-300">Pengelolaan Master Data & Penugasan</p>
            </div>
            <div class="flex items-center gap-3">
                <a href="/api/export-excel" class="bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold px-3 py-2 rounded-lg transition shadow flex items-center gap-1">
                    <span>📥 Unduh Rekap Excel (.xlsx)</span>
                </a>
                <a href="/logout" class="text-xs bg-emerald-800 hover:bg-emerald-700 text-white px-3 py-2 rounded-lg transition border border-emerald-700">Logout</a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto p-4 md:p-6 grid md:grid-cols-3 gap-6">

        <!-- KOLOM KIRI: FORM TAMBAH DATA & PENUGASAN -->
        <div class="md:col-span-1 space-y-6">

            <!-- 1. Form Penugasan Ustadz -->
            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                <h2 class="text-base font-bold text-emerald-900 mb-3 border-b pb-2">Penugasan Ustadz / Dzah</h2>
                <form action="/api/assign-ustadz" method="POST" class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Pilih Pengajar</label>
                        <select name="ustadz_id" required class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                            <% ustadzList.forEach(u => { %>
                                <option value="<%= u.id %>"><%= u.name %> (<%= u.no_wa %>)</option>
                            <% }); %>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Pilih Program</label>
                        <select name="program" required class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                            <option value="alquran">Al-Qur'an (Tahsin/Tahfizh)</option>
                            <option value="aisar">Aisar (Level 1-5)</option>
                            <option value="bahasa_arab">Bahasa Arab</option>
                            <option value="dzikir_doa">Dzikir & Doa</option>
                        </select>
                    </div>

                    <button type="submit" class="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-2 rounded-lg shadow text-xs">
                        Simpan Penugasan
                    </button>
                </form>
            </div>

            <!-- 2. Form Tambah Ustadz / Dzah -->
            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                <h2 class="text-base font-bold text-emerald-900 mb-3 border-b pb-2">Tambah Ustadz / Dzah Baru</h2>
                <form action="/api/add-ustadz" method="POST" class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Nama Lengkap</label>
                        <input type="text" name="name" required placeholder="Ustadz / Dzah..." class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Nomor WhatsApp</label>
                        <input type="text" name="no_wa" required placeholder="08123456789" class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Password</label>
                        <input type="password" name="password" required placeholder="••••••••" class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                    </div>
                    <button type="submit" class="w-full bg-emerald-800 hover:bg-emerald-900 text-white font-bold py-2 rounded-lg shadow text-xs">
                        + Tambah Ustadz / Dzah
                    </button>
                </form>
            </div>

            <!-- 3. Form Tambah Wali Santri -->
            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                <h2 class="text-base font-bold text-emerald-900 mb-3 border-b pb-2">Tambah Wali Santri</h2>
                <form action="/api/add-wali" method="POST" class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Nama Wali</label>
                        <input type="text" name="name" required placeholder="Bapak Ahmad" class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Nomor WhatsApp</label>
                        <input type="text" name="no_wa" required placeholder="08123456789" class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Password</label>
                        <input type="password" name="password" required placeholder="••••••••" class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                    </div>
                    <button type="submit" class="w-full bg-slate-800 hover:bg-slate-900 text-white font-bold py-2 rounded-lg shadow text-xs">
                        + Tambah Akun Wali
                    </button>
                </form>
            </div>

            <!-- 4. Form Tambah Santri -->
            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                <h2 class="text-base font-bold text-emerald-900 mb-3 border-b pb-2">Tambah Data Santri</h2>
                <form action="/api/add-santri" method="POST" class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Nama Santri</label>
                        <input type="text" name="nama_santri" required placeholder="Muhammad Bilal" class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Pilih Orang Tua (Wali)</label>
                        <select name="wali_id" required class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                            <% waliList.forEach(w => { %>
                                <option value="<%= w.id %>"><%= w.name %> (<%= w.no_wa %>)</option>
                            <% }); %>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Pilih Ustadz Pembimbing</label>
                        <select name="ustadz_id" class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                            <option value="">-- Belum Ditentukan --</option>
                            <% ustadzList.forEach(u => { %>
                                <option value="<%= u.id %>"><%= u.name %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Program / Pendaftaran</label>
                        <select id="programSelect" name="program_utama" required onchange="toggleAisarLevel()" class="w-full p-2 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                            <option value="alquran">Al-Qur'an (Tahsin & Tahfizh)</option>
                            <option value="aisar">Aisar</option>
                            <option value="bahasa_arab">Bahasa Arab</option>
                        </select>
                    </div>

                    <div id="aisarLevelWrapper" class="hidden">
                        <label class="block text-xs font-semibold text-emerald-800 uppercase mb-1">Tingkatan Aisar</label>
                        <select name="aisar_level" class="w-full p-2 bg-emerald-50 border border-emerald-300 text-emerald-900 rounded-lg text-sm font-semibold">
                            <option value="1">Aisar 1</option>
                            <option value="2">Aisar 2</option>
                            <option value="3">Aisar 3</option>
                            <option value="4">Aisar 4</option>
                            <option value="5">Aisar 5</option>
                        </select>
                    </div>

                    <button type="submit" class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-2 rounded-lg shadow text-xs">
                        + Tambah Santri
                    </button>
                </form>
            </div>

        </div>

        <!-- KOLOM KANAN: NAVIGATION TAB TABEL DATA -->
        <div class="md:col-span-2">
            
            <!-- TOMBOL TAB SWITCHER -->
            <div class="flex border-b border-slate-200 mb-4 bg-white p-2 rounded-xl shadow-sm gap-2">
                <button id="btnTabUstadz" onclick="switchTab('ustadz')" class="flex-1 py-2 px-4 text-xs font-bold rounded-lg transition bg-emerald-800 text-white">
                    Data Ustadz / Dzah (<%= ustadzList.length %>)
                </button>
                <button id="btnTabWali" onclick="switchTab('wali')" class="flex-1 py-2 px-4 text-xs font-bold rounded-lg transition bg-slate-100 text-slate-600 hover:bg-slate-200">
                    Data Wali Santri (<%= waliList.length %>)
                </button>
                <button id="btnTabSantri" onclick="switchTab('santri')" class="flex-1 py-2 px-4 text-xs font-bold rounded-lg transition bg-slate-100 text-slate-600 hover:bg-slate-200">
                    Data Santri (<%= santriList.length %>)
                </button>
            </div>

            <!-- KONTEN TAB 1: DATA USTADZ & PENUGASAN -->
            <div id="contentUstadz" class="space-y-6">
                <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                    <h2 class="text-base font-bold text-slate-800 mb-3 border-b pb-2">Master Data Ustadz / Ustadzah</h2>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left text-slate-600">
                            <thead class="text-xs text-slate-700 uppercase bg-slate-100">
                                <tr>
                                    <th class="px-4 py-2">Nama Pengajar</th>
                                    <th class="px-4 py-2">Nomor WhatsApp</th>
                                    <th class="px-4 py-2 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (ustadzList.length > 0) { %>
                                    <% ustadzList.forEach(u => { %>
                                        <tr class="border-b hover:bg-slate-50">
                                            <td class="px-4 py-2 font-semibold text-slate-800"><%= u.name %></td>
                                            <td class="px-4 py-2 text-slate-600"><%= u.no_wa %></td>
                                            <td class="px-4 py-2 text-center">
                                                <a href="/api/delete-ustadz/<%= u.id %>" onclick="return confirm('Hapus ustadz ini?')" class="bg-red-100 hover:bg-red-200 text-red-700 font-bold px-2 py-1 rounded text-xs">Hapus</a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr><td colspan="3" class="px-4 py-4 text-center text-slate-400">Belum ada data ustadz.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                    <h2 class="text-base font-bold text-slate-800 mb-3 border-b pb-2">Daftar Penugasan Program</h2>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left text-slate-600">
                            <thead class="text-xs text-slate-700 uppercase bg-slate-100">
                                <tr>
                                    <th class="px-4 py-2">Ustadz / Dzah</th>
                                    <th class="px-4 py-2">Program Ditugaskan</th>
                                    <th class="px-4 py-2 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (assignments.length > 0) { %>
                                    <% assignments.forEach(a => { %>
                                        <tr class="border-b hover:bg-slate-50">
                                            <td class="px-4 py-2 font-semibold text-slate-800"><%= a.ustadz_name %></td>
                                            <td class="px-4 py-2">
                                                <span class="bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full text-xs">
                                                    <%= a.program %>
                                                </span>
                                            </td>
                                            <td class="px-4 py-2 text-center">
                                                <a href="/api/delete-assignment/<%= a.id %>" onclick="return confirm('Hapus penugasan ini?')" class="bg-red-100 hover:bg-red-200 text-red-700 font-bold px-2 py-1 rounded text-xs">Hapus</a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr><td colspan="3" class="px-4 py-4 text-center text-slate-400">Belum ada penugasan.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- KONTEN TAB 2: DATA WALI SANTRI -->
            <div id="contentWali" class="hidden space-y-6">
                <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                    <h2 class="text-base font-bold text-slate-800 mb-3 border-b pb-2">Master Data Wali Santri</h2>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left text-slate-600">
                            <thead class="text-xs text-slate-700 uppercase bg-slate-100">
                                <tr>
                                    <th class="px-4 py-2">Nama Wali</th>
                                    <th class="px-4 py-2">Nomor WhatsApp</th>
                                    <th class="px-4 py-2 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (waliList.length > 0) { %>
                                    <% waliList.forEach(w => { %>
                                        <tr class="border-b hover:bg-slate-50">
                                            <td class="px-4 py-2 font-semibold text-slate-800"><%= w.name %></td>
                                            <td class="px-4 py-2 text-slate-600"><%= w.no_wa %></td>
                                            <td class="px-4 py-2 text-center">
                                                <a href="/api/delete-wali/<%= w.id %>" onclick="return confirm('Hapus wali santri ini?')" class="bg-red-100 hover:bg-red-200 text-red-700 font-bold px-2 py-1 rounded text-xs">Hapus</a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr><td colspan="3" class="px-4 py-4 text-center text-slate-400">Belum ada data wali.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- KONTEN TAB 3: DATA SANTRI -->
            <div id="contentSantri" class="hidden space-y-6">
                <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                    <h2 class="text-base font-bold text-slate-800 mb-3 border-b pb-2">Master Data Santri</h2>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left text-slate-600">
                            <thead class="text-xs text-slate-700 uppercase bg-slate-100">
                                <tr>
                                    <th class="px-4 py-2">Nama Santri</th>
                                    <th class="px-4 py-2">Program / Level</th>
                                    <th class="px-4 py-2">Orang Tua (Wali)</th>
                                    <th class="px-4 py-2">Ustadz Pembimbing</th>
                                    <th class="px-4 py-2 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (santriList.length > 0) { %>
                                    <% santriList.forEach(s => { %>
                                        <tr class="border-b hover:bg-slate-50">
                                            <td class="px-4 py-2 font-semibold text-emerald-900"><%= s.nama_santri %></td>
                                            <td class="px-4 py-2">
                                                <% if (s.program_utama === 'aisar' || (s.aisar_level && s.aisar_level !== '0')) { %>
                                                    <span class="bg-amber-100 text-amber-800 font-semibold px-2 py-0.5 rounded text-xs">Aisar Level <%= s.aisar_level || 1 %></span>
                                                <% } else if (s.program_utama === 'bahasa_arab') { %>
                                                    <span class="bg-purple-100 text-purple-800 font-semibold px-2 py-0.5 rounded text-xs">Bahasa Arab</span>
                                                <% } else { %>
                                                    <span class="bg-emerald-100 text-emerald-800 font-semibold px-2 py-0.5 rounded text-xs">Al-Qur'an</span>
                                                <% } %>
                                            </td>
                                            <td class="px-4 py-2"><%= s.wali_name %></td>
                                            <td class="px-4 py-2">
                                                <span class="bg-emerald-50 border border-emerald-200 text-emerald-900 font-semibold px-2 py-0.5 rounded text-xs">
                                                    <%= s.ustadz_name %>
                                                </span>
                                            </td>
                                            <td class="px-4 py-2 text-center flex justify-center gap-1">
                                                <button onclick="openEditModal('<%= s.id %>', '<%= s.nama_santri %>', '<%= s.wali_id %>', '<%= s.ustadz_id %>', '<%= s.program_utama %>', '<%= s.aisar_level %>')" class="bg-amber-100 hover:bg-amber-200 text-amber-800 font-bold px-2 py-1 rounded text-xs">
                                                    Edit / Hubungkan
                                                </button>
                                                <a href="/api/delete-santri/<%= s.id %>" onclick="return confirm('Hapus data santri ini?')" class="bg-red-100 hover:bg-red-200 text-red-700 font-bold px-2 py-1 rounded text-xs">
                                                    Hapus
                                                </a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr><td colspan="5" class="px-4 py-4 text-center text-slate-400">Belum ada data santri.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

    </main>

    <!-- MODAL EDIT DATA SANTRI -->
    <div id="editModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6 border border-slate-100">
            <h3 class="text-lg font-bold text-emerald-900 mb-4 border-b pb-2">Edit Data Santri & Hubungkan Ustadz</h3>
            
            <form action="/api/edit-santri" method="POST" class="space-y-4">
                <input type="hidden" id="edit_id" name="id">

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Nama Santri</label>
                    <input type="text" id="edit_nama_santri" name="nama_santri" required class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Hubungkan Orang Tua (Wali)</label>
                    <select id="edit_wali_id" name="wali_id" required class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                        <% waliList.forEach(w => { %>
                            <option value="<%= w.id %>"><%= w.name %> (<%= w.no_wa %>)</option>
                        <% }); %>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Hubungkan Ustadz Pembimbing</label>
                    <select id="edit_ustadz_id" name="ustadz_id" class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                        <option value="">-- Belum Ditentukan --</option>
                        <% ustadzList.forEach(u => { %>
                            <option value="<%= u.id %>"><%= u.name %></option>
                        <% }); %>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Program Utama</label>
                    <select id="edit_programSelect" name="program_utama" onchange="toggleEditAisarLevel()" class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                        <option value="alquran">Al-Qur'an (Tahsin & Tahfizh)</option>
                        <option value="aisar">Aisar</option>
                        <option value="bahasa_arab">Bahasa Arab</option>
                    </select>
                </div>

                <div id="edit_aisarLevelWrapper" class="hidden">
                    <label class="block text-xs font-semibold text-emerald-800 uppercase mb-1">Tingkatan Aisar</label>
                    <select id="edit_aisar_level" name="aisar_level" class="w-full p-2.5 bg-emerald-50 border border-emerald-300 text-emerald-900 rounded-lg text-sm font-semibold">
                        <option value="1">Aisar 1</option>
                        <option value="2">Aisar 2</option>
                        <option value="3">Aisar 3</option>
                        <option value="4">Aisar 4</option>
                        <option value="5">Aisar 5</option>
                    </select>
                </div>

                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="closeEditModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-bold rounded-lg">Batal</button>
                    <button type="submit" class="px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold rounded-lg shadow">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function switchTab(tabName) {
            document.getElementById('contentUstadz').classList.add('hidden');
            document.getElementById('contentWali').classList.add('hidden');
            document.getElementById('contentSantri').classList.add('hidden');

            const activeStyle = "bg-emerald-800 text-white";
            const inactiveStyle = "bg-slate-100 text-slate-600 hover:bg-slate-200";

            document.getElementById('btnTabUstadz').className = `flex-1 py-2 px-4 text-xs font-bold rounded-lg transition ${inactiveStyle}`;
            document.getElementById('btnTabWali').className = `flex-1 py-2 px-4 text-xs font-bold rounded-lg transition ${inactiveStyle}`;
            document.getElementById('btnTabSantri').className = `flex-1 py-2 px-4 text-xs font-bold rounded-lg transition ${inactiveStyle}`;

            if (tabName === 'ustadz') {
                document.getElementById('contentUstadz').classList.remove('hidden');
                document.getElementById('btnTabUstadz').className = `flex-1 py-2 px-4 text-xs font-bold rounded-lg transition ${activeStyle}`;
            } else if (tabName === 'wali') {
                document.getElementById('contentWali').classList.remove('hidden');
                document.getElementById('btnTabWali').className = `flex-1 py-2 px-4 text-xs font-bold rounded-lg transition ${activeStyle}`;
            } else if (tabName === 'santri') {
                document.getElementById('contentSantri').classList.remove('hidden');
                document.getElementById('btnTabSantri').className = `flex-1 py-2 px-4 text-xs font-bold rounded-lg transition ${activeStyle}`;
            }
        }

        function toggleAisarLevel() {
            const programSelect = document.getElementById('programSelect');
            const aisarLevelWrapper = document.getElementById('aisarLevelWrapper');
            if (programSelect.value === 'aisar') {
                aisarLevelWrapper.classList.remove('hidden');
            } else {
                aisarLevelWrapper.classList.add('hidden');
            }
        }

        function toggleEditAisarLevel() {
            const programSelect = document.getElementById('edit_programSelect');
            const aisarLevelWrapper = document.getElementById('edit_aisarLevelWrapper');
            if (programSelect.value === 'aisar') {
                aisarLevelWrapper.classList.remove('hidden');
            } else {
                aisarLevelWrapper.classList.add('hidden');
            }
        }

        function openEditModal(id, nama, waliId, ustadzId, programUtama, aisarLevel) {
            document.getElementById('edit_id').value = id;
            document.getElementById('edit_nama_santri').value = nama;
            document.getElementById('edit_wali_id').value = waliId;
            document.getElementById('edit_ustadz_id').value = ustadzId || "";
            document.getElementById('edit_programSelect').value = programUtama || "alquran";

            if (programUtama === 'aisar' || (aisarLevel && aisarLevel !== 'null' && aisarLevel !== '0')) {
                document.getElementById('edit_aisar_level').value = aisarLevel || "1";
                document.getElementById('edit_aisarLevelWrapper').classList.remove('hidden');
            } else {
                document.getElementById('edit_aisarLevelWrapper').classList.add('hidden');
            }

            document.getElementById('editModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }
    </script>

</body>
</html>