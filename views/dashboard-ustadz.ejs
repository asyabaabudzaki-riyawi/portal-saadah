<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Ustadz - Portal As-Sa'adah</title>
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#65B32E">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .bg-saadah-green { background-color: #65B32E; }
        .bg-saadah-teal { background-color: #007A87; }
        .bg-saadah-orange { background-color: #F39200; }
        .text-saadah-teal { color: #007A87; }
        .text-saadah-green { color: #65B32E; }
    </style>
</head>
<body class="bg-white text-slate-800 min-h-screen flex flex-col md:flex-row">

    <!-- MOBILE HEADER NAVIGASI -->
    <div class="md:hidden bg-white border-b border-slate-200 p-4 flex items-center justify-between sticky top-0 z-20">
        <div class="flex items-center gap-2">
            <img src="/logo.png" onerror="this.onerror=null; this.src='/favicon.svg';" alt="Logo" class="w-8 h-8 object-contain">
            <span class="font-extrabold text-sm text-slate-900">Ustadz Portal</span>
        </div>
        <div class="flex items-center gap-2">
            <a href="/api/export-excel/ustadz" class="bg-amber-50 text-amber-700 text-xs font-bold px-3 py-1.5 rounded-lg border border-amber-300">📊 Excel</a>
            <a href="/logout" class="text-xs text-red-600 font-bold px-2 py-1">Logout</a>
        </div>
    </div>

    <!-- SIDEBAR PC & TABLET -->
    <aside class="w-64 bg-white border-r border-slate-200 hidden md:flex flex-col justify-between p-5 min-h-screen sticky top-0">
        <div>
            <div class="flex items-center gap-3 pb-6 border-b border-slate-100 mb-6">
                <img src="/logo.png" onerror="this.onerror=null; this.src='/favicon.svg';" alt="Logo" class="w-10 h-10 object-contain">
                <div>
                    <h2 class="font-extrabold text-sm text-slate-900 leading-tight">As-Sa'adah</h2>
                    <p class="text-[10px] text-slate-400 font-medium uppercase">Portal Pengajar</p>
                </div>
            </div>

            <nav class="space-y-1.5">
                <a href="/ustadz/dashboard" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold bg-amber-50 text-saadah-orange border border-amber-200">
                    <span>✍️</span> Input Evaluasi Santri
                </a>
                <a href="/api/export-excel/ustadz" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-500 hover:bg-slate-50 transition">
                    <span>📊</span> Unduh Rekap (.xlsx)
                </a>
            </nav>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-amber-100 text-saadah-orange font-bold flex items-center justify-center text-xs">
                    <%= ustadz ? ustadz.name.charAt(0) : 'U' %>
                </div>
                <div class="overflow-hidden">
                    <p class="text-xs font-bold text-slate-800 truncate"><%= ustadz ? ustadz.name : 'Ustadz' %></p>
                    <p class="text-[10px] text-slate-400">Pengajar Binaan</p>
                </div>
            </div>
            <a href="/logout" class="text-xs text-red-500 hover:text-red-700 font-bold" title="Logout">🚪</a>
        </div>
    </aside>

    <!-- KONTEN UTAMA DASHBOARD -->
    <div class="flex-1 flex flex-col min-w-0">

        <header class="hidden md:flex bg-white border-b border-slate-200 px-6 py-4 items-center justify-between sticky top-0 z-10">
            <div>
                <h1 class="text-lg font-bold text-slate-900">Evaluasi Capaian Belajar Santri</h1>
                <p class="text-xs text-slate-500">Berikan penilaian hafalan, modul, dan catatan perkembangan santri binaan Anda.</p>
            </div>
            <a href="/api/export-excel/ustadz" class="bg-amber-50 hover:bg-amber-100 text-amber-700 text-xs font-bold px-4 py-2 rounded-xl border border-amber-300 transition flex items-center gap-2">
                <span>📥</span> Unduh Rekap Santri Binaan
            </a>
        </header>

        <main class="p-4 md:p-6 space-y-6 max-w-7xl">

            <!-- SUMMARY STATS -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Santri Binaan</span>
                        <h3 class="text-2xl font-extrabold text-slate-900 mt-1"><%= santriList ? santriList.length : 0 %></h3>
                        <p class="text-xs text-saadah-teal font-medium mt-0.5">Aktif Dibina</p>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-teal-50 text-saadah-teal flex items-center justify-center text-xl font-bold">
                        👥
                    </div>
                </div>

                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Program Diampu</span>
                        <div class="flex flex-wrap gap-1 mt-1">
                            <% if (myPrograms && myPrograms.length > 0) { %>
                                <% myPrograms.forEach(prog => { %>
                                    <span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded-full"><%= prog %></span>
                                <% }); %>
                            <% } else { %>
                                <span class="text-xs text-slate-400">Belum ada penugasan</span>
                            <% } %>
                        </div>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-amber-50 text-saadah-orange flex items-center justify-center text-xl font-bold">
                        📌
                    </div>
                </div>

                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Penilaian</span>
                        <h3 class="text-2xl font-extrabold text-saadah-green mt-1"><%= recentScores ? recentScores.length : 0 %></h3>
                        <p class="text-xs text-saadah-green font-medium mt-0.5">Nilai Terinput</p>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-lime-50 text-saadah-green flex items-center justify-center text-xl font-bold">
                        ⭐
                    </div>
                </div>
            </div>

<!-- FORM INPUT NILAI SANTRI -->
<div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
    <h3 class="text-sm font-bold text-slate-900 mb-3 flex items-center gap-2">
        <span class="p-1.5 bg-amber-50 text-saadah-orange rounded-lg">✍️</span> Input Penilaian Baru
    </h3>
    
    <% if (myPrograms && myPrograms.length > 0 && santriList && santriList.length > 0) { %>
        <form action="/api/scores" method="POST" class="grid grid-cols-1 md:grid-cols-6 gap-3 text-xs">
            
            <!-- HANYA MENAMPILKAN SANTRI BINAAN -->
            <div class="md:col-span-2">
                <label class="block font-semibold text-slate-600 mb-1">Pilih Santri Binaan</label>
                <select name="santri_id" required class="w-full p-2.5 border rounded-xl bg-slate-50 focus:bg-white">
                    <% santriList.forEach(s => { %>
                        <option value="<%= s.id %>"><%= s.nama_santri %></option>
                    <% }); %>
                </select>
            </div>

            <!-- DUKUNGAN PROGRAM TERMASUK BAHASA ARAB -->
            <div class="md:col-span-1">
                <label class="block font-semibold text-slate-600 mb-1">Program</label>
                <select name="program" required class="w-full p-2.5 border rounded-xl bg-slate-50 focus:bg-white">
                    <% myPrograms.forEach(prog => { %>
                        <option value="<%= prog %>"><%= prog %></option>
                    <% }); %>
                </select>
            </div>

            <div class="md:col-span-1">
                <label class="block font-semibold text-slate-600 mb-1">Sub Modul / Detail</label>
                <input type="text" name="sub_modul" required placeholder="Kosakata / Hal. 1" class="w-full p-2.5 border rounded-xl bg-slate-50 focus:bg-white">
            </div>

            <div class="md:col-span-1">
                <label class="block font-semibold text-slate-600 mb-1">Nilai (0-100)</label>
                <input type="number" name="nilai" min="0" max="100" required placeholder="85" class="w-full p-2.5 border rounded-xl bg-slate-50 focus:bg-white">
            </div>

            <div class="md:col-span-1 flex items-end">
                <button type="submit" class="w-full bg-saadah-orange hover:bg-amber-600 text-white font-bold py-2.5 rounded-xl transition">Simpan Nilai</button>
            </div>

            <div class="md:col-span-6">
                <label class="block font-semibold text-slate-600 mb-1">Catatan Evaluasi Pembimbing</label>
                <input type="text" name="catatan" placeholder="Penguasaan mufrodat sangat baik..." class="w-full p-2.5 border rounded-xl bg-slate-50 focus:bg-white">
            </div>
        </form>
    <% } else if (!santriList || santriList.length === 0) { %>
        <p class="text-xs text-amber-700 bg-amber-50 p-3 rounded-xl border border-amber-200">
            ⚠️ Anda belum memiliki santri binaan. Silakan minta Admin untuk menghubungkan data Santri ke akun Anda pada menu Admin.
        </p>
    <% } else { %>
        <p class="text-xs text-slate-500 italic">Anda belum diberikan penugasan program oleh Admin.</p>
    <% } %>
</div>

            <!-- RIWAYAT PENILAIAN TERBARU -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden p-5">
                <h3 class="text-sm font-bold text-slate-900 mb-4">Riwayat Penilaian Terakhir</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-xs text-left text-slate-600 border-collapse">
                        <thead>
                            <tr class="bg-slate-50 text-slate-500 font-bold uppercase border-b border-slate-200">
                                <th class="p-3">Nama Santri</th>
                                <th class="p-3">Program</th>
                                <th class="p-3">Sub Modul</th>
                                <th class="p-3 text-center">Nilai</th>
                                <th class="p-3">Catatan</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% if (recentScores && recentScores.length > 0) { %>
                                <% recentScores.forEach(sc => { %>
                                    <tr class="hover:bg-slate-50 transition">
                                        <td class="p-3 font-bold text-slate-900"><%= sc.santris ? sc.santris.nama_santri : '-' %></td>
                                        <td class="p-3 font-semibold text-saadah-teal"><%= sc.program %></td>
                                        <td class="p-3"><%= sc.sub_modul || '-' %></td>
                                        <td class="p-3 text-center">
                                            <span class="bg-amber-100 text-amber-800 font-extrabold px-2.5 py-1 rounded-lg">
                                                <%= sc.nilai %>
                                            </span>
                                        </td>
                                        <td class="p-3 text-slate-500 italic"><%= sc.catatan || '-' %></td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="p-6 text-center text-slate-400">Belum ada riwayat penilaian.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

</body>
</html>