<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=10">
    <link rel="alternate icon" type="image/png" href="/logo.png">
    <title>Dashboard Ustadz / Dzah</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col justify-between">

    <div>
        <!-- Header -->
        <header class="bg-amber-700 text-white py-4 px-6 shadow-md">
            <div class="max-w-6xl mx-auto flex justify-between items-center">
                <div>
                    <h1 class="text-xl font-bold">Portal Ustadz / Dzah</h1>
                    <p class="text-xs text-amber-200">Pengajar: <%= ustadz ? ustadz.name : 'Ustadz' %></p>
                </div>
                <div class="flex items-center gap-3">
                    <!-- Tombol Unduh Laporan Seluruh Santri Binaan -->
                    <a href="/api/export-excel/ustadz" 
                       class="bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold px-3 py-2 rounded-lg transition shadow flex items-center gap-1 border border-amber-400">
                        <span>📥 Unduh Rekap Santri Binaan (.xlsx)</span>
                    </a>
                    <a href="/logout" class="text-xs bg-amber-800 hover:bg-amber-900 text-white px-3 py-2 rounded-lg transition border border-amber-600">Logout</a>
                </div>
            </div>
        </header>

        <main class="max-w-6xl mx-auto p-4 md:p-6 grid md:grid-cols-3 gap-6">

            <!-- FORM PENILAIAN SPESIFIK -->
            <div class="md:col-span-1 bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                <h2 class="text-lg font-bold text-amber-900 mb-4 border-b pb-2">Form Penilaian Santri Binaan</h2>

                <% if (!myPrograms || myPrograms.length === 0) { %>
                    <div class="p-4 bg-amber-50 border border-amber-200 rounded-lg text-amber-800 text-xs leading-relaxed">
                        <strong>Perhatian:</strong> Anda belum menerima penugasan mata pelajaran/program dari Admin. Silakan hubungi Admin lembaga.
                    </div>
                <% } else { %>

                    <form action="/api/scores" method="POST" class="space-y-4">
                        
                        <!-- Pilih Santri Binaan -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Pilih Santri Binaan</label>
                            <% if (santriList && santriList.length > 0) { %>
                                <select name="santri_id" required class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                                    <% santriList.forEach(s => { %>
                                        <option value="<%= s.id %>"><%= s.nama_santri %></option>
                                    <% }); %>
                                </select>
                            <% } else { %>
                                <div class="p-2.5 bg-slate-100 text-slate-500 rounded-lg text-xs">Belum ada santri binaan terhubung.</div>
                            <% } %>
                        </div>

                        <!-- Pilih Program (Kondisional Sesuai Tugas Admin) -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Mata Pelajaran / Program</label>
                            <select id="programSelect" name="program" required onchange="renderSubModulOptions()" class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm font-semibold text-amber-900">
                                <% if (myPrograms.includes('alquran')) { %>
                                    <option value="alquran">Al-Qur'an (Tahsin / Tahfizh)</option>
                                <% } %>
                                <% if (myPrograms.includes('aisar')) { %>
                                    <option value="aisar">Aisar</option>
                                <% } %>
                                <% if (myPrograms.includes('bahasa_arab')) { %>
                                    <option value="bahasa_arab">Bahasa Arab</option>
                                <% } %>
                                <% if (myPrograms.includes('dzikir_doa')) { %>
                                    <option value="dzikir_doa">Dzikir & Doa Harian</option>
                                <% } %>
                            </select>
                        </div>

                        <!-- Detail Sub Modul Dinamis -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Detail Modul / Hafalan</label>
                            <input type="text" id="subModulInput" name="sub_modul" required placeholder="Contoh: Tahsin / Surah An-Nas" class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                        </div>

                        <!-- Input Nilai -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Nilai Evaluasi (0-100)</label>
                            <input type="number" name="nilai" min="0" max="100" required placeholder="85" class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm">
                        </div>

                        <!-- Catatan Evaluasi -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Catatan Ustadz/ah</label>
                            <textarea name="catatan" rows="3" placeholder="Catatan kelancaran & makhraj..." class="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm"></textarea>
                        </div>

                        <button type="submit" <%= (!santriList || santriList.length === 0) ? 'disabled' : '' %> class="w-full bg-amber-600 hover:bg-amber-700 disabled:bg-slate-300 text-white font-bold py-2.5 rounded-lg shadow transition text-sm">
                            Simpan Penilaian
                        </button>
                    </form>

                <% } %>
            </div>

            <!-- RIWAYAT NILAI YANG DIINPUT USTADZ -->
            <div class="md:col-span-2 bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                <h2 class="text-lg font-bold text-slate-800 mb-4 border-b pb-2">Riwayat Nilai Terinput</h2>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left text-slate-600">
                        <thead class="text-xs text-slate-700 uppercase bg-slate-100">
                            <tr>
                                <th class="px-4 py-3">Santri Binaan</th>
                                <th class="px-4 py-3">Program</th>
                                <th class="px-4 py-3 text-center">Nilai</th>
                                <th class="px-4 py-3">Catatan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (recentScores && recentScores.length > 0) { %>
                                <% recentScores.forEach(s => { %>
                                    <tr class="border-b hover:bg-slate-50">
                                        <td class="px-4 py-3 font-semibold text-slate-800"><%= s.santris ? s.santris.nama_santri : '-' %></td>
                                        <td class="px-4 py-3">
                                            <span class="bg-amber-100 text-amber-900 font-semibold px-2 py-0.5 rounded text-xs">
                                                <%= s.program %> (<%= s.sub_modul %>)
                                            </span>
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            <span class="bg-emerald-100 text-emerald-800 font-bold px-2.5 py-1 rounded-full text-xs"><%= s.nilai %></span>
                                        </td>
                                        <td class="px-4 py-3 italic text-xs text-slate-500"><%= s.catatan || '-' %></td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="px-4 py-6 text-center text-slate-400">Belum ada penilaian yang diinput.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

    <!-- Footer -->
    <footer class="bg-slate-200 text-center py-4 text-xs text-slate-500 border-t border-slate-300">
        Portal Perkembangan Santri Pesantren &copy; 2026
    </footer>

    <script>
        function renderSubModulOptions() {
            const progElem = document.getElementById('programSelect');
            if(!progElem) return;
            const prog = progElem.value;
            const subInput = document.getElementById('subModulInput');

            if (prog === 'alquran') {
                subInput.placeholder = "Contoh: Tahsin Juz 30 / Tahfizh Surah An-Naba";
            } else if (prog === 'bahasa_arab') {
                subInput.placeholder = "Contoh: Mufrodat Harian / Kosakata Perkenalan";
            } else if (prog === 'aisar') {
                subInput.placeholder = "Contoh: Jilid 2 Halaman 15";
            } else if (prog === 'dzikir_doa') {
                subInput.placeholder = "Contoh: Doa Sebelum Makan & Dzikir Pagi";
            }
        }
        if(document.getElementById('programSelect')) renderSubModulOptions();
    </script>

</body>
</html>