<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Perkembangan Santri - Rumah Belajar & Mengaji As-Sa'adah</title>
    
    <!-- FAVICON SVG & PWA MANIFEST -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#65B32E">
    
    <!-- Tailwind CSS & Google Fonts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .font-arabic { font-family: 'Amiri', serif; }
        .bg-saadah-green { background-color: #65B32E; }
        .bg-saadah-teal { background-color: #007A87; }
        .bg-saadah-orange { background-color: #F39200; }
        .text-saadah-teal { color: #007A87; }
        .text-saadah-green { color: #65B32E; }
        .border-saadah-green { border-color: #65B32E; }
    </style>
</head>
<body class="bg-white text-slate-800 min-h-screen flex flex-col justify-between">

    <!-- TOP BANNER SIKAP ISLAMI (RESPONSIF HP, TAB, PC) -->
    <header class="bg-saadah-green py-3.5 px-4 text-center shadow-sm sticky top-0 z-20">
        <h2 class="font-arabic text-2xl md:text-3xl font-bold text-white tracking-wide dir-rtl">
            أَهْلًا وَسَهْلًا وَمَرْحَبًا بِكُمْ
        </h2>
        <p class="text-xs md:text-sm text-lime-100 font-bold mt-1 tracking-wide uppercase">
            Selamat Datang di Portal Rumah Belajar dan Mengaji As-Sa'adah
        </p>
    </header>

    <!-- HERO SECTION KONTEN UTAMA -->
    <main class="max-w-5xl mx-auto px-4 py-8 md:py-12 flex-grow flex flex-col justify-center items-center text-center">
        
        <!-- LOGO BRAND DENGAN GLOW SOFT -->
        <div class="mb-6 relative">
            <div class="absolute -inset-2 rounded-full bg-lime-200/50 blur-xl"></div>
            <img src="/logo.png" onerror="this.onerror=null; this.src='/favicon.svg';" alt="Logo Rumah Belajar & Mengaji As-Sa'adah" class="relative w-32 h-32 md:w-36 md:h-36 object-contain drop-shadow-md mx-auto">
        </div>

        <!-- JUDUL APLIKASI -->
        <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight max-w-2xl leading-tight">
            Portal Evaluasi & Capaian Belajar <span class="text-saadah-teal underline decoration-[#F39200] decoration-wavy decoration-2">Santri</span>
        </h1>
        <p class="mt-3 text-sm md:text-base text-slate-600 max-w-xl leading-relaxed">
            Platform terpadu Rumah Belajar dan Mengaji As-Sa'adah untuk memantau hafalan Al-Qur'an, Aisar, Bahasa Arab, serta rekapitulasi nilai santri secara real-time.
        </p>

        <!-- TOMBOL INSTALL APLIKASI PWA (MUNCUL OTOMATIS DI HP/DESKTOP) -->
        <div id="installContainer" class="mt-5 hidden">
            <button id="btnInstall" class="bg-saadah-orange hover:bg-amber-600 text-white font-bold text-xs md:text-sm px-5 py-2.5 rounded-full shadow-md hover:shadow-lg transition flex items-center gap-2 mx-auto border border-amber-400">
                <span>📲</span> Install Aplikasi Portal di HP / Laptop
            </button>
        </div>

        <!-- PILIHAN PORTAL LOGIN (ROLE CARDS E-LEARNING) -->
        <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-5 w-full max-w-3xl">
            
            <!-- Login Admin -->
            <a href="/login/admin" class="group bg-white hover:bg-slate-50 border-2 border-slate-200 hover:border-saadah-green p-6 rounded-2xl transition-all duration-300 shadow-sm hover:shadow-md hover:-translate-y-1 text-left flex flex-col justify-between">
                <div>
                    <div class="w-12 h-12 bg-lime-50 text-[#65B32E] group-hover:bg-saadah-green group-hover:text-white rounded-2xl flex items-center justify-center text-2xl mb-4 transition-colors">
                        ⚙️
                    </div>
                    <h3 class="text-base font-bold text-slate-900 group-hover:text-[#65B32E]">Portal Admin</h3>
                    <p class="text-xs text-slate-500 mt-1 leading-relaxed">Kelola data master ustadz, wali, santri & penugasan program.</p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-saadah-green">
                    <span>Masuk Portal</span>
                    <span>→</span>
                </div>
            </a>

            <!-- Login Ustadz -->
            <a href="/login/ustadz" class="group bg-white hover:bg-slate-50 border-2 border-slate-200 hover:border-[#007A87] p-6 rounded-2xl transition-all duration-300 shadow-sm hover:shadow-md hover:-translate-y-1 text-left flex flex-col justify-between">
                <div>
                    <div class="w-12 h-12 bg-teal-50 text-[#007A87] group-hover:bg-[#007A87] group-hover:text-white rounded-2xl flex items-center justify-center text-2xl mb-4 transition-colors">
                        📖
                    </div>
                    <h3 class="text-base font-bold text-slate-900 group-hover:text-[#007A87]">Portal Ustadz / Dzah</h3>
                    <p class="text-xs text-slate-500 mt-1 leading-relaxed">Input nilai evaluasi hafalan & catatan perkembangan santri binaan.</p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-saadah-teal">
                    <span>Masuk Portal</span>
                    <span>→</span>
                </div>
            </a>

            <!-- Login Wali -->
            <a href="/login/wali" class="group bg-white hover:bg-slate-50 border-2 border-slate-200 hover:border-[#F39200] p-6 rounded-2xl transition-all duration-300 shadow-sm hover:shadow-md hover:-translate-y-1 text-left flex flex-col justify-between">
                <div>
                    <div class="w-12 h-12 bg-amber-50 text-[#F39200] group-hover:bg-[#F39200] group-hover:text-white rounded-2xl flex items-center justify-center text-2xl mb-4 transition-colors">
                        👨‍👩‍👧
                    </div>
                    <h3 class="text-base font-bold text-slate-900 group-hover:text-[#F39200]">Portal Wali Santri</h3>
                    <p class="text-xs text-slate-500 mt-1 leading-relaxed">Pantau nilai anak kandung & unduh rekap (Excel/PDF/JPG).</p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-saadah-orange">
                    <span>Masuk Portal</span>
                    <span>→</span>
                </div>
            </a>

        </div>

    </main>

    <!-- FOOTER -->
    <footer class="py-4 text-center text-xs text-slate-500 bg-white border-t border-slate-200">
        Rumah Belajar dan Mengaji As-Sa'adah &copy; 2026
    </footer>

    <!-- SCRIPT REGISTRASI PWA -->
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js');
        }

        let deferredPrompt;
        const installContainer = document.getElementById('installContainer');
        const btnInstall = document.getElementById('btnInstall');

        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            installContainer.classList.remove('hidden');
        });

        btnInstall.addEventListener('click', async () => {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                const { outcome } = await deferredPrompt.userChoice;
                if (outcome === 'accepted') {
                    installContainer.classList.add('hidden');
                }
                deferredPrompt = null;
            }
        });
    </script>

</body>
</html>