<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=10">
    <link rel="alternate icon" type="image/png" href="/logo.png">
    <title>Login Portal <%= role.toUpperCase() %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 min-h-screen flex items-center justify-center p-4">

    <div class="bg-white rounded-2xl shadow-lg max-w-md w-full p-8 border border-slate-200">
        <!-- Header Form -->
        <div class="text-center mb-6">
            <h2 class="text-2xl font-bold text-emerald-900">Portal Login <%= role.toUpperCase() %></h2>
            <p class="text-slate-500 text-sm mt-1">Masukkan Nomor WhatsApp dan Password kamu</p>
        </div>

        <!-- Alert Error -->
        <div id="alertError" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg text-sm mb-4"></div>

        <!-- Form Login -->
        <form id="loginForm" class="space-y-4">
            <input type="hidden" id="role" value="<%= role %>">

            <div>
                <label class="block text-slate-700 text-sm font-semibold mb-1">Nomor WhatsApp</label>
                <input type="text" id="no_wa" placeholder="081234567890" required
                    class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none text-slate-800">
            </div>

            <div>
                <label class="block text-slate-700 text-sm font-semibold mb-1">Password</label>
                <input type="password" id="password" placeholder="••••••••" required
                    class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none text-slate-800">
            </div>

            <button type="submit" 
                class="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-semibold py-2.5 rounded-lg transition shadow">
                Masuk ke Portal
            </button>
        </form>

        <div class="mt-6 text-center">
            <a href="/" class="text-xs text-emerald-700 hover:underline">← Kembali ke Halaman Utama</a>
        </div>
    </div>

    <script>
        document.getElementById('loginForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const alertError = document.getElementById('alertError');
            alertError.classList.add('hidden');

            const no_wa = document.getElementById('no_wa').value;
            const password = document.getElementById('password').value;
            const role = document.getElementById('role').value;

            try {
                const res = await fetch('/api/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ no_wa, password, role })
                });

                const data = await res.json();

                if (data.success) {
                    // Simpan data user lokal sementara & redirect
                    localStorage.setItem('user', JSON.stringify(data.user));
                    window.location.href = data.redirectUrl;
                } else {
                    alertError.innerText = data.message;
                    alertError.classList.remove('hidden');
                }
            } catch (err) {
                alertError.innerText = 'Terjadi kesalahan pada server.';
                alertError.classList.remove('hidden');
            }
        });
    </script>
</body>
</html>