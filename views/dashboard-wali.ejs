<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=10">
    <link rel="alternate icon" type="image/png" href="/logo.png">
    <title>Dashboard Wali Santri</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Library html2canvas untuk Ekspor JPG di Sisi Client -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col justify-between">

    <div>
        <!-- Header Utama -->
        <header class="bg-emerald-800 text-white py-4 px-6 shadow-md">
            <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
                <div>
                    <h1 class="text-xl font-bold">Portal Wali Santri</h1>
                    <p class="text-xs text-emerald-200">Selamat datang, <%= wali ? wali.name : 'Wali Santri' %></p>
                </div>
                
                <!-- Group Tombol Aksi Unduh & Logout -->
                <div class="flex items-center gap-2 flex-wrap">
                    <% if (selectedSantri) { %>
                        <span class="text-xs font-semibold text-emerald-200 hidden md:inline">Unduh Laporan:</span>
                        
                        <!-- Format Excel -->
                        <a href="/api/export-excel/wali?santri_id=<%= selectedSantri.id %>" 
                           class="bg-emerald-700 hover:bg-emerald-600 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition shadow border border-emerald-500 flex items-center gap-1">
                            <span>📊 Excel</span>
                        </a>

                        <!-- Format PDF -->
                        <a href="/api/export-pdf/wali?santri_id=<%= selectedSantri.id %>" 
                           class="bg-red-600 hover:bg-red-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition shadow border border-red-400 flex items-center gap-1">
                            <span>📄 PDF</span>
                        </a>

                        <!-- Format JPG (Client-Side Capture) -->
                        <button onclick="downloadJPG()" 
                           class="bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition shadow border border-amber-400 flex items-center gap-1">
                            <span>🖼️ JPG</span>
                        </button>
                    <% } %>

                    <a href="/logout" class="text-xs bg-emerald-950 hover:bg-black text-white px-3 py-1.5 rounded-lg transition border border-emerald-700 ml-2">Logout</a>
                </div>
            </div>
        </header>

        <!-- Konten Utama -->
        <main class="max-w-6xl mx-auto p-4 md:p-6">

            <!-- Multi-Anak Switcher (Dropdown Pemilihan Anak Kandung) -->
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="w-full md:w-1/2">
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Pilih Santri (Anak Kandung):</label>
                    <form id="switchForm" method="GET" action="/wali/dashboard">
                        <select name="santri_id" onchange="document.getElementById('switchForm').submit()" 
                            class="bg-emerald-50 border border-emerald-300 text-emerald-900 text-sm font-semibold rounded-lg focus:ring-emerald-500 focus:border-emerald-500 block w-full p-2.5">
                            <% if (anakList && anakList.length > 0) { %>
                                <% anakList.forEach(anak => { %>
                                    <option value="<%= anak.id %>" <%= selectedSantri && selectedSantri.id == anak.id ? 'selected' : '' %>>
                                        👤 <%= anak.nama_santri %> <%= anak.aisar_level ? '(Aisar Level ' + anak.aisar_level + ')' : '' %>
                                    </option>
                                <% }); %>
                            <% } else { %>
                                <option value="">Tidak ada santri terhubung</option>
                            <% } %>
                        </select>
                    </form>
                </div>

                <% if (selectedSantri) { %>
                    <div class="bg-emerald-50 border border-emerald-200 p-3 rounded-lg text-right w-full md:w-auto">
                        <span class="text-xs text-emerald-700 font-medium">Santri Terpilih:</span>
                        <h3 class="text-lg font-bold text-emerald-900"><%= selectedSantri.nama_santri %></h3>
                    </div>
                <% } %>
            </div>

            <!-- Area yang akan di-capture ke JPG (ID: reportArea) -->
            <% if (selectedSantri) { %>
                <div id="reportArea" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden p-6">
                    <!-- Kop Laporan -->
                    <div class="border-b-2 border-emerald-700 pb-4 mb-4 flex justify-between items-center">
                        <div>
                            <h2 class="text-xl font-bold text-emerald-900">LAPORAN EVALUASI SANTRI</h2>
                            <p class="text-xs text-slate-500">Laporan Hasil Belajar & Perkembangan Santri Pesantren</p>
                        </div>
                        <div class="text-right text-xs text-slate-600">
                            <p><strong>Nama Santri:</strong> <%= selectedSantri.nama_santri %></p>
                            <p><strong>Program:</strong> <%= selectedSantri.program_utama ? selectedSantri.program_utama.toUpperCase() : 'AL-QURAN' %> <%= selectedSantri.aisar_level ? '(Level ' + selectedSantri.aisar_level + ')' : '' %></p>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left text-slate-600 border border-slate-200">
                            <thead class="text-xs text-white uppercase bg-emerald-800">
                                <tr>
                                    <th class="px-4 py-3 border">Program / Mapel</th>
                                    <th class="px-4 py-3 border">Sub Modul / Detail Hafalan</th>
                                    <th class="px-4 py-3 border text-center">Nilai</th>
                                    <th class="px-4 py-3 border">Catatan Ustadz</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (scores && scores.length > 0) { %>
                                    <% scores.forEach(score => { %>
                                        <tr class="bg-white border-b hover:bg-slate-50">
                                            <td class="px-4 py-3 border font-semibold text-emerald-900"><%= score.program %></td>
                                            <td class="px-4 py-3 border"><%= score.sub_modul || '-' %></td>
                                            <td class="px-4 py-3 border text-center">
                                                <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-2.5 py-1 rounded-full">
                                                    <%= score.nilai %>
                                                </span>
                                            </td>
                                            <td class="px-4 py-3 border italic text-slate-500"><%= score.catatan || 'Tidak ada catatan.' %></td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="px-6 py-8 text-center text-slate-400">Belum ada data penilaian untuk santri ini.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } else { %>
                <div class="p-8 text-center bg-white rounded-xl border border-slate-200 text-slate-500">
                    Belum ada santri yang terhubung dengan akun Wali ini. Silakan hubungi Admin lembaga.
                </div>
            <% } %>

        </main>
    </div>

    <!-- Footer -->
    <footer class="bg-slate-200 text-center py-4 text-xs text-slate-500 border-t border-slate-300 mt-8">
        Portal Laporan Perkembangan Santri Pesantren &copy; 2026
    </footer>

    <!-- Script Download JPG via HTML2Canvas -->
    <script>
        function downloadJPG() {
            const element = document.getElementById('reportArea');
            if (!element) return;

            html2canvas(element, { scale: 2 }).then(canvas => {
                const link = document.createElement('a');
                link.download = 'Laporan_<%= selectedSantri ? selectedSantri.nama_santri.replace(/[^a-zA-Z0-9]/g, "_") : "Santri" %>.jpg';
                link.href = canvas.toDataURL('image/jpeg', 0.9);
                link.click();
            });
        }
    </script>

</body>
</html>