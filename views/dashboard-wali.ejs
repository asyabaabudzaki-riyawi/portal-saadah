<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Wali - Portal As-Sa'adah</title>
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#65B32E">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .bg-saadah-green { background-color: #65B32E; }
        .bg-saadah-teal { background-color: #007A87; }
        .bg-saadah-orange { background-color: #F39200; }
        .text-saadah-teal { color: #007A87; }
        .text-saadah-green { color: #65B32E; }
        .border-saadah-green { border-color: #65B32E; }
    </style>
</head>
<body class="bg-white text-slate-800 min-h-screen flex">

    <!-- SIDEBAR NAVIGASI (LAYOUT FIGMA) -->
    <aside class="w-64 bg-white border-r border-slate-200 hidden md:flex flex-col justify-between p-5 min-h-screen sticky top-0">
        <div>
            <!-- BRAND LOGO -->
            <div class="flex items-center gap-3 pb-6 border-b border-slate-100 mb-6">
                <img src="/logo.png" onerror="this.onerror=null; this.src='/favicon.svg';" alt="Logo" class="w-10 h-10 object-contain">
                <div>
                    <h2 class="font-extrabold text-sm text-slate-900 leading-tight">As-Sa'adah</h2>
                    <p class="text-[10px] text-slate-400 font-medium uppercase">Portal Belajar</p>
                </div>
            </div>

            <!-- MENU NAVIGASI -->
            <nav class="space-y-1.5">
                <a href="/wali/dashboard" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold bg-lime-50 text-saadah-green border border-lime-200">
                    <span>📊</span> Dashboard Evaluasi
                </a>
                <a href="#" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-500 hover:bg-slate-50 transition">
                    <span>📖</span> Jadwal Mengaji
                </a>
                <a href="#" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-500 hover:bg-slate-50 transition">
                    <span>📜</span> Sertifikat Santri
                </a>
            </nav>
        </div>

        <!-- USER PROFILE SIDEBAR -->
        <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-teal-100 text-saadah-teal font-bold flex items-center justify-center text-xs">
                    <%= wali ? wali.name.charAt(0) : 'W' %>
                </div>
                <div class="overflow-hidden">
                    <p class="text-xs font-bold text-slate-800 truncate"><%= wali ? wali.name : 'Wali Santri' %></p>
                    <p class="text-[10px] text-slate-400">Wali Santri</p>
                </div>
            </div>
            <a href="/logout" class="text-xs text-red-500 hover:text-red-700 font-bold" title="Logout">🚪</a>
        </div>
    </aside>

    <!-- MAIN CONTENT AREA -->
    <div class="flex-1 flex flex-col min-w-0">

        <!-- TOPBAR HEADER -->
        <header class="bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between gap-4 sticky top-0 z-10">
            <div>
                <h1 class="text-lg font-bold text-slate-900">Evaluasi Belajar Santri</h1>
                <p class="text-xs text-slate-500">Pantau perkembangan hafalan & capaian modul anak secara real-time.</p>
            </div>

            <!-- AKSI EKSPOR LAPORAN -->
            <% if (selectedSantri) { %>
                <div class="flex items-center gap-2">
                    <a href="/api/export-excel/wali?santri_id=<%= selectedSantri.id %>" 
                       class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-bold px-3 py-2 rounded-lg border border-emerald-300 transition flex items-center gap-1.5">
                        📊 Excel
                    </a>
                    <a href="/api/export-pdf/wali?santri_id=<%= selectedSantri.id %>" 
                       class="bg-red-50 hover:bg-red-100 text-red-700 text-xs font-bold px-3 py-2 rounded-lg border border-red-300 transition flex items-center gap-1.5">
                        📄 PDF
                    </a>
                    <button onclick="downloadJPG()" 
                       class="bg-amber-50 hover:bg-amber-100 text-amber-700 text-xs font-bold px-3 py-2 rounded-lg border border-amber-300 transition flex items-center gap-1.5">
                        🖼️ JPG
                    </button>
                </div>
            <% } %>
        </header>

        <!-- DASHBOARD BODY -->
        <main class="p-6 space-y-6 max-w-7xl">

            <!-- STATS CARDS (SUMMARY METRICS FIGMA STYLE) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                
                <!-- Card 1: Pilih Santri -->
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Santri Terpilih</span>
                    <form id="switchForm" method="GET" action="/wali/dashboard" class="mt-2">
                        <select name="santri_id" onchange="document.getElementById('switchForm').submit()" 
                            class="bg-slate-50 border border-slate-300 text-slate-900 text-xs font-bold rounded-xl focus:ring-saadah-green focus:border-saadah-green block w-full p-2.5">
                            <% if (anakList && anakList.length > 0) { %>
                                <% anakList.forEach(anak => { %>
                                    <option value="<%= anak.id %>" <%= selectedSantri && selectedSantri.id == anak.id ? 'selected' : '' %>>
                                        👤 <%= anak.nama_santri %>
                                    </option>
                                <% }); %>
                            <% } else { %>
                                <option value="">Tidak ada santri</option>
                            <% } %>
                        </select>
                    </form>
                </div>

                <!-- Card 2: Program Utama -->
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Program Utama</span>
                        <h3 class="text-base font-extrabold text-saadah-teal mt-1">
                            <%= selectedSantri && selectedSantri.program_utama ? selectedSantri.program_utama.toUpperCase() : 'AL-QURAN' %>
                        </h3>
                        <p class="text-xs text-slate-500 mt-0.5">
                            <%= selectedSantri && selectedSantri.aisar_level ? 'Level Aisar: ' + selectedSantri.aisar_level : 'Program Reguler' %>
                        </p>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-teal-50 text-saadah-teal flex items-center justify-center text-xl font-bold">
                        📚
                    </div>
                </div>

                <!-- Card 3: Total Evaluasi -->
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Evaluasi</span>
                        <h3 class="text-2xl font-extrabold text-slate-900 mt-1"><%= scores ? scores.length : 0 %></h3>
                        <p class="text-xs text-saadah-green font-semibold mt-0.5">Modul Dinilai</p>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-lime-50 text-saadah-green flex items-center justify-center text-xl font-bold">
                        ⭐
                    </div>
                </div>

            </div>

            <!-- TABEL LAPORAN (AREA REKAP DETAIL) -->
            <% if (selectedSantri) { %>
                <div id="reportArea" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden p-6">
                    
                    <div class="flex flex-col md:flex-row md:items-center justify-between pb-4 mb-4 border-b border-slate-100 gap-2">
                        <div>
                            <h2 class="text-base font-bold text-slate-900">Laporan Hasil Belajar</h2>
                            <p class="text-xs text-slate-500">Santri: <strong class="text-saadah-teal"><%= selectedSantri.nama_santri %></strong></p>
                        </div>
                        <span class="text-xs bg-lime-100 text-saadah-green font-bold px-3 py-1 rounded-full w-fit">
                            Aktif / Terverifikasi
                        </span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-xs text-left text-slate-600 border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 font-bold uppercase border-b border-slate-200">
                                    <th class="p-3">Program / Mapel</th>
                                    <th class="p-3">Sub Modul / Detail Hafalan</th>
                                    <th class="p-3 text-center">Nilai</th>
                                    <th class="p-3">Catatan Ustadz</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (scores && scores.length > 0) { %>
                                    <% scores.forEach(score => { %>
                                        <tr class="hover:bg-slate-50/80 transition">
                                            <td class="p-3 font-bold text-saadah-teal"><%= score.program %></td>
                                            <td class="p-3 font-medium text-slate-700"><%= score.sub_modul || '-' %></td>
                                            <td class="p-3 text-center">
                                                <span class="bg-amber-100 text-amber-800 font-extrabold px-2.5 py-1 rounded-lg">
                                                    <%= score.nilai %>
                                                </span>
                                            </td>
                                            <td class="p-3 text-slate-500 italic"><%= score.catatan || 'Tidak ada catatan.' %></td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="p-8 text-center text-slate-400">Belum ada data evaluasi untuk santri ini.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } %>

        </main>
    </div>

    <!-- SCRIPT DOWNLOAD JPG -->
    <script>
        function downloadJPG() {
            const element = document.getElementById('reportArea');
            if (!element) return;

            html2canvas(element, { scale: 2, backgroundColor: '#ffffff' }).then(canvas => {
                const link = document.createElement('a');
                link.download = 'Laporan_<%= selectedSantri ? selectedSantri.nama_santri.replace(/[^a-zA-Z0-9]/g, "_") : "Santri" %>.jpg';
                link.href = canvas.toDataURL('image/jpeg', 0.95);
                link.click();
            });
        }
    </script>

</body>
</html>